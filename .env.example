# Copy this file to ".env" and fill in real values there. ".env" itself is never
# committed to version history (see .gitignore) — this file is just a template.

ANTHROPIC_API_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=

# License service (see license-service/README.md) - these are the *public*
# Supabase project URL and anon key, safe to ship in the built app; the
# service-role key never leaves the Edge Functions runtime.
PANGA_LICENSE_SUPABASE_URL=
PANGA_LICENSE_SUPABASE_ANON_KEY=
