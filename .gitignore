# Private user data — resume, interview answers, job/application history. Never committed.
data/

# Secrets
.env

# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Native-packaging (Phase 2) build output - regenerate with PyInstaller/Inno
# Setup, never commit the output itself (see docs/native-packaging-phase2-build.md)
build_venv/
build_dist/
build_work/
installer_output/
*.spec.bak

# Bundled friend-test-package installer binary - large, fetched fresh from
# python.org for packaging (see installers/README.txt), not source.
installers/

# OS
Thumbs.db
.DS_Store

# Claude Code local/machine-specific settings (permission grants etc.)
.claude/settings.local.json

# Worktree metadata for parallel feature-branch sessions - not real content
.claude/worktrees/

# Supabase CLI local build/link cache - machine-specific, not real content
license-service/supabase/.temp/
